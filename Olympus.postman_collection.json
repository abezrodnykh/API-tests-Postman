        {
          "name": "201 Create - Успешное добавление новой сущности",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "pm.test(\"Response time is less than 200ms\", function () {\r",
                  "\tpm.expect(pm.response.responseTime).to.be.below(200);\r",
                  "});\r",
                  "\r",
                  "// 1. Схема для валидации одного объекта\r",
                  "const mythologySchema = {\r",
                  "  \"type\": \"object\",\r",
                  "  \"required\": [\"id\", \"name\", \"category\", \"desc\", \"img\"],\r",
                  "  \"properties\": {\r",
                  "    \"id\": { \"type\": \"number\" },\r",
                  "    \"name\": { \"type\": \"string\" },\r",
                  "    \"category\": { \"type\": \"string\" },\r",
                  "    \"desc\": { \"type\": \"string\" },\r",
                  "    \"img\": { \"type\": \"string\" }\r",
                  "  }\r",
                  "};\r",
                  "\r",
                  "// 2. Проверка соответствия ответа схеме\r",
                  "pm.test(\"Схема ответа валидна (MythologyEntity)\", function () {\r",
                  "    pm.response.to.have.jsonSchema(mythologySchema);\r",
                  "});\r",
                  "\r",
                  "// 3. Проверка что это объект\r",
                  "pm.test(\"Ответ является объектом\", function () {\r",
                  "    pm.expect(pm.response.json()).to.be.an('object');\r",
                  "});\r",
                  "\r",
                  "\r",
                  "// 1. Парсим тело ответа в JSON-объект\r",
                  "const responseData = pm.response.json();\r",
                  "\r",
                  "// 2. Извлекаем значения (путь зависит от структуры вашего JSON)\r",
                  "const id = responseData.id;\r",
                  "const name = responseData.name;\r",
                  "const category = responseData.category;\r",
                  "const desc = responseData.desc;\r",
                  "const img = responseData.img;\r",
                  " \r",
                  "\r",
                  "// 3. Сохраняем в переменнst коллекции (наиболее удобный вариант)\r",
                  "pm.environment.set(\"extracted_id\", id);\r",
                  "pm.environment.set(\"extracted_name\", name);\r",
                  "pm.environment.set(\"extracted_category\", category);\r",
                  "pm.environment.set(\"extracted_desc\", desc);\r",
                  "pm.environment.set(\"extracted_img\", img);\r",
                  "// Альтернатива: сохранить в глобальную переменную\r",
                  "// pm.globals.set(\"extracted_id\", id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// 1. Генерация числа от 1 до 500\r",
                  "const randomId = Math.floor(Math.random() * 500) + 1;\r",
                  "\r",
                  "// 2. Генерация строки с текущей датой, чтобы сделать имя уникальным\r",
                  "const timestamp = Date.now();\r",
                  "const uniqueName = \"test_user_\" + timestamp;\r",
                  "\r",
                  "// ТЕПЕРЬ СОХРАНЯЕМ В ПЕРЕМЕННЫЕ:\r",
                  "// Мы кладем эти значения в \"окружение\", чтобы использовать их в самом запросе\r",
                  "pm.environment.set(\"temp_id\", randomId);\r",
                  "pm.environment.set(\"temp_name\", uniqueName);\r",
                  "\r",
                  "\r",
                  "const _ = require('lodash');\r",
                  "\r",
                  "// Выбрать случайное значение из списка (массива)\r",
                  "const roles = [\"gods\", \"heroes\", \"creatures\"];\r",
                  "const randomRole = _.sample(roles);\r",
                  "\r",
                  "pm.environment.set(\"random_role\", randomRole);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{temp_name}}\",\r\n  \"category\": \"{{random_role}}\",\r\n  \"desc\": \"{{$randomPhrase}}\",\r\n  \"img\": \"{{$randomImageUrl}}\"\r\n}",
