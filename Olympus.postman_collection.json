      "item": [
        {
          "name": "201 - Регистрация нового пользователя",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "pm.test(\"Response time is less than 200ms\", function () {\r",
                  "\tpm.expect(pm.response.responseTime).to.be.below(200);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// 1. Генерация числа от 1 до 500\r",
                  "const randomId = Math.floor(Math.random() * 500) + 1;\r",
                  "\r",
                  "// 2. Генерация строки с текущей датой, чтобы сделать имя уникальным\r",
                  "const timestamp = Date.now();\r",
                  "const uniqueName = \"test_user_\" + timestamp;\r",
                  "\r",
                  "// ТЕПЕРЬ СОХРАНЯЕМ В ПЕРЕМЕННЫЕ:\r",
                  "// Мы кладем эти значения в \"окружение\", чтобы использовать их в самом запросе\r",
                  "pm.environment.set(\"temp_id\", randomId);\r",
                  "pm.environment.set(\"temp_name\", uniqueName);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"{{temp_name}}\",\r\n  \"password\": \"{{password}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            }
          },
          "response": []
